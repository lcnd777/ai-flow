{
  "manifest_version": 3,
  "name": "AI Flow — Usage Monitor",
  "short_name": "AI Flow",
  "version": "0.7.0",
  "description": "Suivi transparent des quotas Claude et ChatGPT, alertes facultatives et prévision de session. Stockage local.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "action": {
    "default_title": "AI Flow — Quotas IA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "shared.js",
      "usage-parser.js",
      "claude-api.js",
      "codex-api.js",
      "background.js"
    ],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "shared.js",
        "usage-parser.js",
        "transfer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "version_name": "0.7.0"
}
