{
  "manifest_version": 3,
  "name": "AI Flow — Usage Monitor",
  "short_name": "AI Flow",
  "version": "0.10.0",
  "version_name": "0.10.0",
  "description": "Quotas de Claude et Codex, Smart Switch, relance après quota, transfert de contexte. Tout reste sur ton appareil.",
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "AI Flow",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": [
      "platforms.js",
      "shared.js",
      "readers.js",
      "background.js"
    ],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "platforms.js",
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
